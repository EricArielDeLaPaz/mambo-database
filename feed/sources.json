   "match": "\\bmaterial (3|expressive|design|you)\\b"
  },
  {
   "filter": "apple-design",
   "field": "all",
   "match": "\\b(human interface guidelines|liquid glass|HIG)\\b"
  },
  {
   "filter": "optimization",
   "field": "all",
   "match": "\\b(quantiz\\w*|distill\\w*|compress\\w*|pruning|low-bit|sparsity|speedup)\\b"
  },
  {
   "filter": "books",
   "field": "all",
   "match": "\\b(e-?books?|new books?)\\b"
  },
  {
   "filter": "design-systems",
   "field": "all",
   "match": "\\b(design systems?|design tokens?|component librar\\w+)\\b"
  },
  {
   "filter": "accessibility",
   "field": "title",
   "match": "\\b(accessib\\w*|wcag|a11y|aria)\\b"
  },
  {
   "filter": "motion",
   "field": "title",
   "match": "\\b(animations?|motion|view transitions?|scroll-driven)\\b"
  },
  {
   "filter": "typography",
