{
  "id": "slider",
  "type": "component",
  "name": "Slider",
  "category": "forms",
  "level": "atom",
  "platforms": [
    "desktop-web",
    "desktop-app",
    "tablet",
    "mobile-web",
    "ios",
    "android"
  ],
  "industries": [
    "all"
  ],
  "summary": "A track with a draggable handle for choosing a value or range by feel.",
  "anatomy": [
    {
      "part": "label",
      "required": true,
      "purpose": "Names the value."
    },
    {
      "part": "track",
      "required": true,
      "purpose": "The full range line, 4 to 8px thick."
    },
    {
      "part": "fill",
      "required": true,
      "purpose": "Filled part up to the handle."
    },
    {
      "part": "handle",
      "required": true,
      "purpose": "Draggable thumb, 24px minimum (44px touch area)."
    },
    {
      "part": "value",
      "required": true,
      "purpose": "Current value as text."
    }
  ],
  "variants": [
    {
      "id": "single",
      "name": "Single",
      "use": "Volume, brightness.",
      "contentLimits": {
        "steps": "continuous or stepped"
      }
    },
    {
      "id": "range",
      "name": "Range",
      "use": "Price filter with two handles.",
      "contentLimits": {
        "handles": "2",
        "value": "min to max"
      }
    },
    {
      "id": "stepped",
      "name": "Stepped with ticks",
      "use": "A few named levels.",
      "contentLimits": {
        "steps": "3 to 7"
      }
    }
  ],
  "whenToUse": [
    "A value where 'about right' is good enough."
  ],
  "whenNotToUse": [
    "Exact numbers: add a number input beside it.",
    "Few discrete choices: use radio buttons or a segmented control."
  ],
  "alternatives": [
    "number-input",
    "segmented-control"
  ],
  "tokens": [
    "color.primary",
    "color.border.strong",
    "radius.pill"
  ],
  "accessibility": {
    "role": "slider",
    "keyboard": [
      "Arrow keys change by one step.",
      "Page Up/Down by a larger step.",
      "Home/End jump to min/max."
    ],
    "focus": "Focus ring around the handle.",
    "notes": [
      "Show the value as text; do not rely on position.",
      "Set aria-valuemin, max and now.",
      "Touch area at least 44px.",
      "Offer a text alternative for precision."
    ]
  },
  "states": [
    {
      "id": "focus",
      "label": "Focus (keyboard)",
      "when": "all",
      "note": "",
      "css": ".sl:focus-visible{outline:2px solid #1d4ed8;outline-offset:2px}"
    },
    {
      "id": "disabled",
      "label": "Disabled",
      "when": "all",
      "note": "",
      "css": ".sl:disabled{opacity:.4;cursor:not-allowed}"
    }
  ],
  "related": [
    "number-input",
    "segmented-control"
  ],
  "code": {
    "html": "<label for=\"vol\" class=\"sl__l\">Volume <output for=\"vol\">40</output></label>\n<input id=\"vol\" class=\"sl\" type=\"range\" min=\"0\" max=\"100\" value=\"40\">",
    "css": ".sl__l{display:flex;justify-content:space-between;width:260px;margin-bottom:6px;font:600 14px system-ui,sans-serif}\n.sl{width:260px;accent-color:#0a0a0a;height:24px}",
    "js": "document.querySelectorAll('.sl').forEach(range => {\n  const out = range.previousElementSibling.querySelector('output');\n  const sync = () => {\n    out.textContent = range.value; range.setAttribute('aria-valuetext', range.value + ' percent');\n    range.style.setProperty('--p', ((range.value - range.min) / (range.max - range.min) * 100) + '%');\n  };\n  range.addEventListener('input', sync); sync();\n});"
  },
  "interactive": true,
  "os": {
    "ios": {
      "css": ".sl{-webkit-appearance:none;appearance:none;height:28px;background:transparent;accent-color:#0a84ff}.sl::-webkit-slider-runnable-track{height:4px;border-radius:2px;background:linear-gradient(90deg,#0a84ff var(--p,40%),#d1d1d6 var(--p,40%))}.sl::-webkit-slider-thumb{-webkit-appearance:none;width:28px;height:28px;margin-top:-12px;border-radius:50%;background:#fff;box-shadow:0 1px 4px rgba(0,0,0,.4)}.sl::-moz-range-track{height:4px;border-radius:2px;background:#d1d1d6}.sl::-moz-range-progress{height:4px;border-radius:2px;background:#0a84ff}.sl::-moz-range-thumb{width:28px;height:28px;border:0;border-radius:50%;background:#fff;box-shadow:0 1px 4px rgba(0,0,0,.4)}.sl__l{font-family:-apple-system,system-ui,sans-serif}"
    },
    "android": {
      "css": ".sl{-webkit-appearance:none;appearance:none;height:44px;background:transparent;accent-color:#6750a4}.sl::-webkit-slider-runnable-track{height:16px;border-radius:8px;background:linear-gradient(90deg,#6750a4 var(--p,40%),#e8def8 var(--p,40%))}.sl::-webkit-slider-thumb{-webkit-appearance:none;width:4px;height:44px;margin-top:-14px;border-radius:2px;background:#6750a4}.sl::-moz-range-track{height:16px;border-radius:8px;background:#e8def8}.sl::-moz-range-progress{height:16px;border-radius:8px;background:#6750a4}.sl::-moz-range-thumb{width:4px;height:44px;border:0;border-radius:2px;background:#6750a4}.sl__l{font-family:Roboto,system-ui,sans-serif}"
    }
  }
}
