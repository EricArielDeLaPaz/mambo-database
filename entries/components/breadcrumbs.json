{
  "id": "breadcrumbs",
  "type": "component",
  "name": "Breadcrumbs",
  "category": "navigation",
  "level": "molecule",
  "platforms": [
    "desktop-web",
    "desktop-app",
    "tablet",
    "mobile-web"
  ],
  "industries": [
    "all"
  ],
  "summary": "A trail of links that shows where the page sits in the site and lets people go back up.",
  "anatomy": [
    {
      "part": "list",
      "required": true,
      "purpose": "Ordered list inside a nav."
    },
    {
      "part": "link",
      "required": true,
      "purpose": "Each ancestor page."
    },
    {
      "part": "separator",
      "required": true,
      "purpose": "Decorative slash or chevron."
    },
    {
      "part": "current",
      "required": true,
      "purpose": "The last item is plain text with aria-current=page."
    }
  ],
  "variants": [
    {
      "id": "full",
      "name": "Full trail",
      "use": "Desktop, up to 4 levels.",
      "contentLimits": {
        "levels": "2 to 5",
        "label": "max 24 characters each"
      }
    },
    {
      "id": "collapsed",
      "name": "Collapsed",
      "use": "Long trails: show first, last and a More item.",
      "contentLimits": {
        "levels": "more than 4",
        "label": "max 24 characters"
      }
    }
  ],
  "whenToUse": [
    "Deep hierarchies such as stores and docs."
  ],
  "whenNotToUse": [
    "Flat sites with 1 or 2 levels.",
    "As the only navigation."
  ],
  "alternatives": [
    "top-navigation-bar",
    "link"
  ],
  "tokens": [
    "color.text.secondary",
    "color.link",
    "space.2"
  ],
  "accessibility": {
    "role": "navigation (aria-label=Breadcrumb) with an ordered list",
    "keyboard": [
      "Tab moves through links."
    ],
    "focus": "Visible focus ring on each link.",
    "notes": [
      "The separator is decorative: aria-hidden or CSS.",
      "Current page: aria-current=page.",
      "Place above the page title, at the top."
    ]
  },
  "states": [
    {
      "id": "focus",
      "label": "Focus (keyboard)",
      "when": "all",
      "note": "",
      "css": ".bc a:focus-visible{outline:2px solid #1d4ed8;outline-offset:2px}"
    },
    {
      "id": "hover",
      "label": "Hover (pointer devices)",
      "when": "pointer",
      "note": "Skip on mobile-only products.",
      "css": "@media (hover:hover){.bc a:hover{text-decoration-thickness:2px}}"
    }
  ],
  "related": [
    "top-navigation-bar",
    "link"
  ],
  "code": {
    "html": "<nav aria-label=\"Breadcrumb\"><ol class=\"bc\">\n  <li><a href=\"#\">Home</a></li>\n  <li><a href=\"#\">Case studies</a></li>\n  <li aria-current=\"page\">Vextaro</li>\n</ol></nav>",
    "css": ".bc{display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin:0;padding:0;font:14px system-ui,sans-serif;color:#525252}\n.bc li+li::before{content:'/';margin-right:8px;color:#8a8a8a}\n.bc a{color:#0a0a0a}"
  }
}
