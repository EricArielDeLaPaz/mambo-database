{
  "id": "search-field",
  "type": "component",
  "name": "Search field",
  "category": "forms",
  "level": "molecule",
  "platforms": [
    "desktop-web",
    "desktop-app",
    "tablet",
    "mobile-web",
    "ios",
    "android"
  ],
  "industries": [
    "all"
  ],
  "summary": "A text input specialised for queries, with a search icon and a clear button.",
  "anatomy": [
    {
      "part": "container",
      "required": true,
      "purpose": "Rounded field, 44px tall."
    },
    {
      "part": "search-icon",
      "required": true,
      "purpose": "Decorative magnifier, not the only label."
    },
    {
      "part": "input",
      "required": true,
      "purpose": "type=search with an accessible label."
    },
    {
      "part": "clear-button",
      "required": false,
      "purpose": "Appears when there is text; clears and refocuses the input."
    },
    {
      "part": "suggestions",
      "required": false,
      "purpose": "Optional list under the field."
    }
  ],
  "variants": [
    {
      "id": "inline",
      "name": "Inline",
      "use": "Header or toolbar search.",
      "contentLimits": {
        "placeholder": "max 30 characters"
      }
    },
    {
      "id": "expanded",
      "name": "Expanded with suggestions",
      "use": "Search-first pages.",
      "contentLimits": {
        "suggestions": "max 8 rows"
      }
    }
  ],
  "whenToUse": [
    "Finding items in a large set.",
    "Header or page-level search."
  ],
  "whenNotToUse": [
    "Filtering a short list: use filter controls.",
    "A non-query field: use a text input."
  ],
  "alternatives": [
    "text-input"
  ],
  "tokens": [
    "color.border.strong",
    "radius.pill",
    "space.3"
  ],
  "accessibility": {
    "role": "search landmark with a searchbox",
    "keyboard": [
      "Enter submits.",
      "Escape clears suggestions."
    ],
    "focus": "Focus ring on the field.",
    "notes": [
      "Wrap in role=search.",
      "Label with aria-label; a placeholder is not enough.",
      "Announce result counts with a live region."
    ]
  },
  "states": [
    {
      "id": "focus",
      "label": "Focus (keyboard)",
      "when": "all",
      "note": "",
      "css": ".sf__input:focus-visible{outline:2px solid #1d4ed8;outline-offset:2px}"
    },
    {
      "id": "hover",
      "label": "Hover (pointer devices)",
      "when": "pointer",
      "note": "Skip on mobile-only products.",
      "css": "@media (hover:hover){.sf__input:hover{border-color:#0a0a0a}}"
    }
  ],
  "related": [
    "text-input"
  ],
  "code": {
    "html": "<form role=\"search\" class=\"sf\">\n  <svg class=\"sf__icon\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-3.5-3.5\"/></svg>\n  <input class=\"sf__input\" type=\"search\" aria-label=\"Search components\" placeholder=\"Search components\">\n</form>",
    "css": ".sf{position:relative;max-width:360px}\n.sf__icon{position:absolute;left:14px;top:13px}\n.sf__input{width:100%;min-height:44px;padding:0 14px 0 40px;border:1px solid #8a8a8a;border-radius:999px;font:16px system-ui,sans-serif}",
    "js": "document.querySelectorAll('form.sf').forEach(form => {\n  const input = form.querySelector('input');\n  form.addEventListener('submit', e => { e.preventDefault(); /* demo only: run your search here */ });\n  input.addEventListener('keydown', e => { if (e.key === 'Escape') input.value = ''; });\n});"
  },
  "os": {
    "ios": {
      "css": ".sf__input{border:0;border-radius:10px;background:#eeeef0;min-height:36px;font:17px -apple-system,'SF Pro Text',system-ui,sans-serif}.sf__icon{top:9px}"
    },
    "android": {
      "css": ".sf__input{min-height:56px;border:0;background:#ececec;font:16px Roboto,system-ui,sans-serif}.sf__icon{top:19px}"
    }
  },
  "interactive": true
}
