{
  "id": "toggle-button",
  "type": "component",
  "name": "Toggle button",
  "category": "buttons",
  "level": "atom",
  "platforms": [
    "desktop",
    "mobile-web",
    "mobile-app"
  ],
  "industries": [
    "all"
  ],
  "summary": "A button that stays pressed or unpressed, such as bold, favorite or mute.",
  "anatomy": [
    {
      "part": "button",
      "required": true,
      "purpose": "A button with aria-pressed."
    },
    {
      "part": "icon-or-label",
      "required": true,
      "purpose": "What it controls."
    },
    {
      "part": "pressed-state",
      "required": true,
      "purpose": "Filled background plus a changed icon, not color alone."
    }
  ],
  "variants": [
    {
      "id": "icon",
      "name": "Icon",
      "use": "Toolbars.",
      "contentLimits": {
        "size": "44px square"
      }
    },
    {
      "id": "label",
      "name": "With label",
      "use": "Filters like Open now.",
      "contentLimits": {
        "label": "max 16 characters"
      }
    },
    {
      "id": "group",
      "name": "Group",
      "use": "Several related toggles, such as bold, italic, underline.",
      "contentLimits": {
        "items": "2 to 5"
      }
    }
  ],
  "whenToUse": [
    "Two states on the same control, applied right away."
  ],
  "whenNotToUse": [
    "An on/off setting in a list: use a switch.",
    "One choice from several: use a segmented control."
  ],
  "alternatives": [
    "toggle-switch",
    "segmented-control",
    "icon-button"
  ],
  "tokens": [
    "color.primary",
    "color.border.strong",
    "radius.md"
  ],
  "accessibility": {
    "role": "button with aria-pressed",
    "keyboard": [
      "Space or Enter toggles."
    ],
    "focus": "Focus ring on the button.",
    "notes": [
      "Do not change the label when toggling; aria-pressed carries the state.",
      "Pressed needs a shape or fill change, not only color.",
      "Touch target 44px."
    ]
  },
  "states": [
    {
      "id": "hover",
      "label": "Hover (pointer devices)",
      "when": "pointer",
      "note": "Skip on mobile-only products.",
      "css": "@media (hover:hover){.tgb:not([aria-pressed=true]):hover{background:#f0f0f0}}"
    },
    {
      "id": "focus",
      "label": "Focus (keyboard)",
      "when": "all",
      "note": "",
      "css": ".tgb:focus-visible{outline:2px solid #1d4ed8;outline-offset:2px}"
    },
    {
      "id": "disabled",
      "label": "Disabled",
      "when": "all",
      "note": "",
      "css": ".tgb:disabled{opacity:.45;cursor:not-allowed}"
    }
  ],
  "related": [
    "toggle-switch",
    "segmented-control",
    "icon-button"
  ],
  "code": {
    "html": "<button type=\"button\" class=\"tgb\" aria-pressed=\"true\">\n  <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 21s-8-5-8-11a4.5 4.5 0 018-2.8A4.5 4.5 0 0120 10c0 6-8 11-8 11z\"/></svg>\n  Favorite\n</button>",
    "css": ".tgb{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 16px;border:1px solid #0a0a0a;border-radius:999px;background:#fff;color:#0a0a0a;font:600 14px system-ui,sans-serif;cursor:pointer}\n.tgb[aria-pressed=true]{background:#0a0a0a;color:#fff}"
  }
}
