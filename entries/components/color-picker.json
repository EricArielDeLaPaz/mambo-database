{
  "id": "color-picker",
  "type": "component",
  "name": "Color picker",
  "category": "forms",
  "level": "organism",
  "platforms": [
    "desktop",
    "mobile-web"
  ],
  "industries": [
    "all"
  ],
  "summary": "A control for choosing a color from swatches, with a hex field for exact values.",
  "anatomy": [
    {
      "part": "swatches",
      "required": true,
      "purpose": "Preset colors as buttons."
    },
    {
      "part": "hex-field",
      "required": true,
      "purpose": "Type or paste a hex value."
    },
    {
      "part": "preview",
      "required": true,
      "purpose": "Large sample of the chosen color."
    },
    {
      "part": "contrast",
      "required": false,
      "purpose": "Ratio against a background, with Pass/Fail text."
    }
  ],
  "variants": [
    {
      "id": "swatches",
      "name": "Swatches",
      "use": "Small sets such as brand colors.",
      "contentLimits": {
        "swatches": "6 to 20"
      }
    },
    {
      "id": "full",
      "name": "Full spectrum",
      "use": "Design tools.",
      "contentLimits": {
        "controls": "area, hue, hex"
      }
    },
    {
      "id": "native",
      "name": "Native input",
      "use": "Quick and accessible.",
      "contentLimits": {
        "type": "input type=color"
      }
    }
  ],
  "whenToUse": [
    "Choosing brand or theme colors."
  ],
  "whenNotToUse": [
    "Choosing from a few named options: use radio buttons.",
    "Photos: use an image picker."
  ],
  "alternatives": [
    "select",
    "text-input"
  ],
  "tokens": [
    "color.border.strong",
    "radius.md",
    "space.2"
  ],
  "accessibility": {
    "role": "group of buttons (swatches) plus a textbox",
    "keyboard": [
      "Arrow keys move among swatches.",
      "Enter selects.",
      "Hex field accepts paste."
    ],
    "focus": "Focus ring on each swatch.",
    "notes": [
      "Name each swatch in text, not only color.",
      "Show a check on the selected swatch.",
      "Warn when contrast fails.",
      "Provide the hex field for keyboard users."
    ]
  },
  "states": [
    {
      "id": "focus",
      "label": "Focus (keyboard)",
      "when": "all",
      "note": "",
      "css": ".cp button:focus-visible{outline:2px solid #1d4ed8;outline-offset:2px}"
    }
  ],
  "related": [
    "select",
    "text-input"
  ],
  "code": {
    "html": "<div class=\"cp\" role=\"group\" aria-label=\"Brand color\">\n  <button aria-label=\"Navy\" style=\"background:#1e3a8a\" aria-pressed=\"true\"></button>\n  <button aria-label=\"Teal\" style=\"background:#0f766e\"></button>\n  <button aria-label=\"Violet\" style=\"background:#6d28d9\"></button>\n  <button aria-label=\"Rust\" style=\"background:#b45309\"></button>\n</div>",
    "css": ".cp{display:flex;gap:8px}\n.cp button{width:36px;height:36px;border:1px solid rgba(0,0,0,.4);border-radius:8px;cursor:pointer}\n.cp button[aria-pressed=true]{outline:3px solid #0a0a0a;outline-offset:2px}"
  }
}
