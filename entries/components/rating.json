      "purpose": "5 stars or numbers, 44px touch area when input."
    },
    {
      "part": "value",
      "required": true,
      "purpose": "Current score as text, such as 4 out of 5."
    },
    {
      "part": "count",
      "required": false,
      "purpose": "Number of ratings."
    }
