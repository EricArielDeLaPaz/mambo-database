  "tags": [],
  "summary": "A row of icon buttons along the bottom of an iPhone screen for actions on the current content, such as share, bookmark, compose and delete.",
  "anatomy": [
    {
      "part": "actions",
      "required": true,
      "purpose": "3 to 5 icon buttons evenly spaced."
    },
    {
      "part": "spacers",
      "required": false,
      "purpose": "Flexible space groups actions."
    },
    {
      "part": "labels",
      "required": true,
      "purpose": "Each icon has an accessible name."
    }
  ],
  "variants": [
    {
      "id": "default",
      "name": "Default",
      "use": "Actions for the current screen.",
      "contentLimits": {
        "actions": "3 to 5"
      }
    }
  ],
  "whenToUse": [
    "Context actions for the content on screen."
  ],
  "whenNotToUse": [
    "Switching sections: use the tab bar.",
    "Android: use a bottom app bar."
  ],
  "alternatives": [
