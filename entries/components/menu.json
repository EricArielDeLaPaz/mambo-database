{
  "id": "menu",
  "type": "component",
  "name": "Menu",
  "category": "overlays",
  "level": "molecule",
  "platforms": [
    "desktop-web",
    "desktop-app",
    "tablet",
    "mobile-web",
    "ios",
    "android"
  ],
  "industries": [
    "all"
  ],
  "summary": "A list of actions that opens from a button, such as More options.",
  "anatomy": [
    {
      "part": "trigger",
      "required": true,
      "purpose": "Button with aria-haspopup=menu."
    },
    {
      "part": "menu",
      "required": true,
      "purpose": "Floating list, min width 180px."
    },
    {
      "part": "item",
      "required": true,
      "purpose": "One action, 40 to 44px tall."
    },
    {
      "part": "separator",
      "required": false,
      "purpose": "Groups related actions."
    },
    {
      "part": "danger-item",
      "required": false,
      "purpose": "Destructive action, last, with text not only color."
    }
  ],
  "variants": [
    {
      "id": "actions",
      "name": "Actions",
      "use": "More options on a row.",
      "contentLimits": {
        "items": "3 to 8",
        "label": "max 24 characters"
      }
    },
    {
      "id": "with-icons",
      "name": "With icons",
      "use": "Frequent actions.",
      "contentLimits": {
        "items": "3 to 8"
      }
    },
    {
      "id": "context",
      "name": "Context menu",
      "use": "Right-click on desktop.",
      "contentLimits": {
        "items": "up to 10"
      }
    }
  ],
  "whenToUse": [
    "Secondary actions that would crowd the screen."
  ],
  "whenNotToUse": [
    "Choosing a value: use a select.",
    "Primary actions: show them as buttons.",
    "Navigation: use navigation links."
  ],
  "alternatives": [
    "popover",
    "select",
    "drawer"
  ],
  "tokens": [
    "color.surface.overlay",
    "color.border.strong",
    "radius.md",
    "shadow.overlay"
  ],
  "accessibility": {
    "role": "menu with menuitem",
    "keyboard": [
      "Enter/Space/Arrow Down opens.",
      "Arrows move; Home/End jump.",
      "Escape closes and returns focus to the trigger.",
      "Typing jumps to an item."
    ],
    "focus": "Focus moves to the first item on open and returns to the trigger on close.",
    "notes": [
      "Do not put form controls inside.",
      "Disabled items stay visible with aria-disabled.",
      "Destructive items are last and labeled in text."
    ]
  },
  "states": [
    {
      "id": "hover",
      "label": "Hover (pointer devices)",
      "when": "pointer",
      "note": "Skip on mobile-only products.",
      "css": "@media (hover:hover){.mn__m button:hover{background:#f0f0f0}}"
    },
    {
      "id": "focus",
      "label": "Focus (keyboard)",
      "when": "all",
      "note": "",
      "css": ".mn__m button,.mn__t:focus-visible{outline:2px solid #1d4ed8;outline-offset:2px}"
    }
  ],
  "related": [
    "popover",
    "select",
    "drawer"
  ],
  "code": {
    "html": "<div class=\"mn\">\n  <button type=\"button\" aria-haspopup=\"menu\" aria-expanded=\"false\" class=\"mn__t\" aria-label=\"More options\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><circle cx=\"5\" cy=\"12\" r=\"2\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><circle cx=\"19\" cy=\"12\" r=\"2\"/></svg></button>\n  <div role=\"menu\" class=\"mn__m\" hidden>\n    <button role=\"menuitem\">Rename</button>\n    <button role=\"menuitem\">Duplicate</button>\n    <button role=\"menuitem\" class=\"mn__d\">Delete</button>\n  </div>\n</div>",
    "css": ".mn{position:relative;display:inline-block;font:14px system-ui,sans-serif}\n.mn__t{display:grid;place-items:center;width:44px;height:44px;padding:0;border:1px solid #0a0a0a;border-radius:999px;background:#fff;cursor:pointer}\n.mn__m{display:grid;min-width:180px;margin-top:6px;padding:4px;background:#fff;border:1px solid #8a8a8a;border-radius:8px;box-shadow:0 14px 34px -10px rgba(0,0,0,.3)}\n.mn__m button{text-align:left;min-height:40px;padding:0 12px;border:0;border-radius:6px;background:none;font:inherit;cursor:pointer}\n.mn__d{color:#b91c1c}\n/* interaction */\n.mn__m{position:absolute;top:100%;left:0;z-index:10}.mn__m[hidden]{display:none}.mn__m button:hover{background:#f0f0f0}\n",
    "frame": "<div class=\"mn\">\n  <button type=\"button\" aria-haspopup=\"menu\" aria-expanded=\"true\" class=\"mn__t\" aria-label=\"More options\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><circle cx=\"5\" cy=\"12\" r=\"2\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><circle cx=\"19\" cy=\"12\" r=\"2\"/></svg></button>\n  <div role=\"menu\" class=\"mn__m\">\n    <button role=\"menuitem\">Rename</button>\n    <button role=\"menuitem\">Duplicate</button>\n    <button role=\"menuitem\" class=\"mn__d\">Delete</button>\n  </div>\n</div>",
    "js": "document.querySelectorAll('.mn').forEach(root => {\n  const trigger = root.querySelector('.mn__t'), menu = root.querySelector('.mn__m');\n  const items = () => [...menu.querySelectorAll('[role=menuitem]')];\n  const close = refocus => { menu.hidden = true; trigger.setAttribute('aria-expanded', 'false'); if (refocus) trigger.focus(); };\n  const open = first => {\n    menu.hidden = false; trigger.setAttribute('aria-expanded', 'true');\n    const list = items(); (first === 'last' ? list[list.length - 1] : list[0]).focus();\n  };\n  trigger.addEventListener('click', () => menu.hidden ? open() : close(true));\n  trigger.addEventListener('keydown', e => {\n    if (e.key === 'ArrowDown') { e.preventDefault(); open(); } else if (e.key === 'ArrowUp') { e.preventDefault(); open('last'); }\n  });\n  menu.addEventListener('keydown', e => {\n    const list = items(), i = list.indexOf(document.activeElement);\n    const to = { ArrowDown: (i + 1) % list.length, ArrowUp: (i - 1 + list.length) % list.length, Home: 0, End: list.length - 1 }[e.key];\n    if (to !== undefined) { e.preventDefault(); list[to].focus(); }\n    else if (e.key === 'Escape') { e.preventDefault(); close(true); }\n    else if (e.key === 'Tab') close(false);\n  });\n  menu.addEventListener('click', e => { if (e.target.closest('[role=menuitem]')) close(true); });\n  document.addEventListener('click', e => { if (!root.contains(e.target)) close(false); });\n});",
    "pvHeight": 300
  },
