      "css": ".mn__t{border:0;background:#eeeef0}.mn__m{border-radius:14px;border:0;font-family:-apple-system,'SF Pro Text',system-ui,sans-serif;min-width:220px}",
      "frame": "<div class=\"mn\">\n  <button type=\"button\" aria-haspopup=\"menu\" aria-expanded=\"true\" class=\"mn__t\" aria-label=\"More options\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><circle cx=\"5\" cy=\"12\" r=\"2\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><circle cx=\"19\" cy=\"12\" r=\"2\"/></svg></button>\n  <div role=\"menu\" class=\"mn__m\">\n    <button role=\"menuitem\">Rename</button>\n    <button role=\"menuitem\">Duplicate</button>\n    <button role=\"menuitem\" class=\"mn__d\">Delete</button>\n  </div>\n</div>"
    },
