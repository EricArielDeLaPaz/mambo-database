  "code": {
    "html": "<aside class=\"dr\" role=\"dialog\" aria-modal=\"false\" aria-labelledby=\"dr-t\">\n  <header class=\"dr__h\"><h2 id=\"dr-t\" class=\"dr__t\">Filters</h2><button aria-label=\"Close\" class=\"dr__x\">&times;</button></header>\n  <div class=\"dr__b\">Drawer content goes here.</div>\n</aside>",
    "css": ".dr{width:320px;border:1px solid #d4d4d4;border-radius:12px;background:#fff;box-shadow:0 18px 40px -12px rgba(0,0,0,.25);font-family:system-ui,sans-serif}\n.dr__h{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;border-bottom:1px solid #d4d4d4}\n.dr__t{margin:0;font-size:18px}\n.dr__x{border:0;background:none;font-size:24px;cursor:pointer;min-width:44px;min-height:44px}\n.dr__b{padding:16px;font-size:15px}"
