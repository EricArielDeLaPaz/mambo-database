  "code": {
    "html": "<div class=\"sp\" role=\"status\"><span class=\"sr\">Loading</span></div>",
    "css": ".sp{width:32px;height:32px;border:4px solid #d4d4d4;border-top-color:#0a0a0a;border-radius:50%;animation:spin .8s linear infinite}\n.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}\n@keyframes spin{to{transform:rotate(360deg)}}\n@media (prefers-reduced-motion:reduce){.sp{animation-duration:2s}}"
  }
