    {
      "id": "focus",
      "label": "Focus (keyboard)",
      "when": "all",
      "note": "",
      "css": ".ass__go,.ass__h button,.ass__b input,.ass__open:focus-visible{outline:2px solid #1d4ed8;outline-offset:2px}"
