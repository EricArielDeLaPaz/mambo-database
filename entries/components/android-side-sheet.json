  "tags": [],
  "summary": "A Material panel that slides in from the side for supplementary content or actions, such as filters. Modal on small screens, standard (beside content) on large ones.",
  "anatomy": [
    {
      "part": "header",
      "required": true,
      "purpose": "Title and a close button."
    },
    {
      "part": "content",
      "required": true,
      "purpose": "Filters, details or actions."
    },
    {
      "part": "actions",
      "required": false,
      "purpose": "Primary action at the bottom."
    },
    {
      "part": "scrim (overlay fill)",
      "required": false,
      "purpose": "Dims the page when modal."
    }
  ],
  "variants": [
    {
      "id": "modal",
      "name": "Modal",
      "use": "Small screens. Blocks the page.",
      "contentLimits": {
        "width": "up to 400dp"
      }
    },
    {
      "id": "standard",
      "name": "Standard",
      "use": "Large screens. Sits beside content.",
      "contentLimits": {
        "width": "up to 400dp"
      }
    }
  ],
  "whenToUse": [
    "Supplementary tasks that do not need a full screen."
  ],
  "whenNotToUse": [
    "Quick choices: use a menu.",
    "Phone-sized screens: prefer a bottom sheet."
  ],
  "alternatives": [
    "drawer",
    "android-navigation-drawer",
    "bottom-sheet"
  ],
