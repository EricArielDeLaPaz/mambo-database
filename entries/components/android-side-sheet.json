    "color.surface.container-low",
    "radius.lg"
  ],
  "accessibility": {
    "role": "dialog",
    "keyboard": [
      "Escape or the close button closes it.",
      "Focus stays inside while modal."
    ],
    "focus": "Focus moves in and returns to the trigger.",
    "notes": [
      "Close button has a name.",
      "Trap focus while modal.",
      "Announce results of applied filters."
    ]
  },
  "states": [
    {
      "id": "hover",
      "label": "Hover (pointer devices)",
      "when": "pointer",
      "note": "Skip on touch-only products.",
