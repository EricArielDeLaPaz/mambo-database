{
  "id": "text-input",
  "type": "component",
  "name": "Text input",
  "category": "forms",
  "level": "molecule",
  "platforms": [
    "desktop",
    "mobile-web",
    "mobile-app"
  ],
  "industries": [
    "all"
  ],
  "summary": "A single-line field with a visible label, optional hint and an error message.",
  "anatomy": [
    {
      "part": "label",
      "required": true,
      "purpose": "Always visible above the field. A placeholder is not a label."
    },
    {
      "part": "field",
      "required": true,
      "purpose": "The input box with a border that has 3:1 contrast."
    },
    {
      "part": "hint",
      "required": false,
      "purpose": "Short help such as the expected format."
    },
    {
      "part": "error-message",
      "required": false,
      "purpose": "Icon plus text that says what is wrong and how to fix it."
    },
    {
      "part": "character-count",
      "required": false,
      "purpose": "Shown when there is a limit."
    }
  ],
  "variants": [
    {
      "id": "default",
      "name": "Default",
      "use": "Standard single-line text.",
      "contentLimits": {
        "label": "max 40 characters",
        "hint": "max 80 characters",
        "error": "max 100 characters, one sentence"
      }
    },
    {
      "id": "with-icon",
      "name": "With leading icon",
      "use": "Search or currency fields.",
      "contentLimits": {
        "label": "max 40 characters",
        "icon": "decorative 20px"
      }
    },
    {
      "id": "textarea",
      "name": "Multi-line",
      "use": "Comments or messages.",
      "contentLimits": {
        "label": "max 40 characters",
        "rows": "min 3",
        "count": "show above 200 characters"
      }
    }
  ],
  "whenToUse": [
    "Collecting short free text: name, email, search."
  ],
  "whenNotToUse": [
    "A small fixed set of options: use radios, select or a segmented control.",
    "Strict formats such as dates: use a specialized input."
  ],
  "alternatives": [
    "select",
    "segmented-control",
    "search-field"
  ],
  "tokens": [
    "color.border.strong",
    "color.text.primary",
    "color.danger",
    "radius.md",
    "space.2"
  ],
  "accessibility": {
    "role": "textbox (native <input>)",
    "keyboard": [
      "Tab moves between fields.",
      "Enter submits a single-line form."
    ],
    "focus": "2px focus ring that stays on click.",
    "notes": [
      "Associate the label with for/id.",
      "Link hint and error with aria-describedby; set aria-invalid=true on error.",
      "Error text needs 4.5:1 and an icon or the word Error.",
      "Use the right type and autocomplete values.",
      "Use 16px text on mobile to stop iOS zoom."
    ]
  },
  "states": [
    {
      "id": "hover",
      "label": "Hover (pointer devices)",
      "when": "pointer",
      "note": "Skip on mobile-only products.",
      "css": "@media (hover:hover){.field__input:hover{border-color:#0a0a0a}}"
    },
    {
      "id": "focus",
      "label": "Focus (keyboard)",
      "when": "all",
      "note": "",
      "css": ".field__input:focus-visible{outline:2px solid #1d4ed8;outline-offset:2px}"
    },
    {
      "id": "error",
      "label": "Error",
      "when": "all",
      "note": "",
      "css": ".field__input[aria-invalid=true]{border-color:#b91c1c}"
    },
    {
      "id": "disabled",
      "label": "Disabled",
      "when": "all",
      "note": "",
      "css": ".field__input:disabled{background:#f5f5f5;color:#737373;cursor:not-allowed}"
    }
  ],
  "related": [
    "select",
    "segmented-control",
    "search-field"
  ],
  "code": {
    "html": "<label class=\"field\">\n  <span class=\"field__label\">Email</span>\n  <input class=\"field__input\" type=\"email\" autocomplete=\"email\" aria-describedby=\"email-hint\">\n  <span id=\"email-hint\" class=\"field__hint\">We only use it to send your receipt.</span>\n</label>",
    "css": ".field{display:grid;gap:6px;font-family:system-ui,sans-serif;max-width:360px}\n.field__label{font-weight:600;font-size:14px}\n.field__input{min-height:44px;padding:0 14px;border:1px solid #8a8a8a;border-radius:8px;font-size:16px}\n.field__hint{font-size:13px;color:#525252}"
  }
}
