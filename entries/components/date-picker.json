{
  "id": "date-picker",
  "type": "component",
  "name": "Date picker",
  "category": "forms",
  "level": "organism",
  "platforms": [
    "desktop-web",
    "desktop-app",
    "tablet",
    "mobile-web",
    "ios",
    "android"
  ],
  "industries": [
    "all"
  ],
  "summary": "A date field that opens a calendar. Always allow typing the date as well.",
  "anatomy": [
    {
      "part": "label",
      "required": true,
      "purpose": "Names the date."
    },
    {
      "part": "field",
      "required": true,
      "purpose": "Text field with a format hint such as MM/DD/YYYY."
    },
    {
      "part": "calendar-button",
      "required": true,
      "purpose": "Opens the calendar, labeled Choose date."
    },
    {
      "part": "calendar",
      "required": true,
      "purpose": "Popup calendar."
    }
  ],
  "variants": [
    {
      "id": "single",
      "name": "Single date",
      "use": "Deadlines and bookings.",
      "contentLimits": {
        "format": "MM/DD/YYYY hint"
      }
    },
    {
      "id": "range",
      "name": "Range",
      "use": "Trips.",
      "contentLimits": {
        "fields": "start and end"
      }
    },
    {
      "id": "native",
      "name": "Native input",
      "use": "Mobile web; the system picker is familiar.",
      "contentLimits": {
        "type": "input type=date"
      }
    }
  ],
  "whenToUse": [
    "Selecting a date in a form."
  ],
  "whenNotToUse": [
    "Dates far in the past: use separate fields.",
    "Just a month: use a select."
  ],
  "alternatives": [
    "calendar",
    "text-input",
    "select"
  ],
  "tokens": [
    "color.border.strong",
    "radius.md",
    "shadow.overlay"
  ],
  "accessibility": {
    "role": "textbox plus a dialog containing a grid",
    "keyboard": [
      "Enter or Down opens.",
      "Escape closes and returns focus to the field.",
      "Typing in the field updates the calendar."
    ],
    "focus": "Focus returns to the calendar button after choosing.",
    "notes": [
      "Show the expected format in the label or hint.",
      "Validate on blur, not on every key.",
      "Do not rely on the calendar alone."
    ]
  },
  "states": [
    {
      "id": "focus",
      "label": "Focus (keyboard)",
      "when": "all",
      "note": "",
      "css": ".dp input,.dp button:focus-visible{outline:2px solid #1d4ed8;outline-offset:2px}"
    },
    {
      "id": "hover",
      "label": "Hover (pointer devices)",
      "when": "pointer",
      "note": "Skip on mobile-only products.",
      "css": "@media (hover:hover){.dp button:hover{background:#f0f0f0}}"
    }
  ],
  "related": [
    "calendar",
    "text-input",
    "select"
  ],
  "code": {
    "html": "<label for=\"dp\" class=\"dp__l\">Start date</label>\n<div class=\"dp\"><input id=\"dp\" placeholder=\"MM/DD/YYYY\" inputmode=\"numeric\"><button type=\"button\" aria-label=\"Choose date\">\n<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M3 10h18M8 3v4M16 3v4\"/></svg></button></div>",
    "css": ".dp__l{display:block;margin-bottom:6px;font:600 14px system-ui,sans-serif}\n.dp{display:flex;width:240px;border:1px solid #8a8a8a;border-radius:8px;overflow:hidden}\n.dp input{flex:1;min-width:0;border:0;padding:0 12px;min-height:44px;font:16px system-ui,sans-serif}\n.dp button{width:44px;border:0;border-left:1px solid #d4d4d4;background:#fff;cursor:pointer}"
  }
}
