{
  "id": "button",
  "type": "component",
  "name": "Button",
  "category": "buttons",
  "level": "atom",
  "platforms": [
    "desktop-web",
    "desktop-app",
    "tablet",
    "mobile-web",
    "ios",
    "android"
  ],
  "industries": [
    "all"
  ],
  "summary": "A control that starts an action. Pill-shaped, with solid, outline, text and destructive styles.",
  "anatomy": [
    {
      "part": "container",
      "required": true,
      "purpose": "Pill-shaped hit area, 44px tall on touch screens."
    },
    {
      "part": "label",
      "required": true,
      "purpose": "Verb-first text, 1 to 3 words. Says the result, not the click."
    },
    {
      "part": "leading-icon",
      "required": false,
      "purpose": "Optional decorative icon before the label."
    },
    {
      "part": "loading-indicator",
      "required": false,
      "purpose": "Replaces the icon while an action runs. Keep width so the layout does not jump."
    }
  ],
  "variants": [
    {
      "id": "solid",
      "name": "Solid (primary)",
      "use": "The one main action on a screen.",
      "contentLimits": {
        "label": "1 to 3 words, max 24 characters",
        "count": "one per view"
      }
    },
    {
      "id": "outline",
      "name": "Outline (secondary)",
      "use": "Supporting actions beside a primary.",
      "contentLimits": {
        "label": "1 to 3 words",
        "count": "up to 3 per view"
      }
    },
    {
      "id": "text",
      "name": "Text (tertiary)",
      "use": "Low-emphasis actions such as Cancel.",
      "contentLimits": {
        "label": "1 to 3 words",
        "count": "as needed"
      }
    },
    {
      "id": "destructive",
      "name": "Destructive",
      "use": "Delete or remove. Pair with a confirmation.",
      "contentLimits": {
        "label": "name the object, e.g. Delete project",
        "count": "rare"
      }
    }
  ],
  "whenToUse": [
    "The person triggers an action on this page: save, send, add.",
    "A form needs a submit control."
  ],
  "whenNotToUse": [
    "The control goes to another page: use a link.",
    "A choice among options: use radios, a toggle or a segmented control.",
    "Several equal actions: use a popover menu."
  ],
  "alternatives": [
    "link",
    "toggle-switch",
    "popover"
  ],
  "tokens": [
    "color.primary",
    "color.primary-text",
    "color.border.strong",
    "radius.pill",
    "space.2",
    "space.4"
  ],
  "accessibility": {
    "role": "button (native <button>)",
    "keyboard": [
      "Enter and Space activate it.",
      "Tab reaches it in reading order."
    ],
    "focus": "Always show a visible focus ring with 3:1 contrast. Do not remove the outline.",
    "notes": [
      "Use a real <button>, not a div.",
      "Touch targets are at least 44x44px.",
      "Explain why a control is disabled nearby.",
      "Hover applies to pointer devices only; on mobile design pressed and focus."
    ]
  },
  "states": [
    {
      "id": "hover",
      "label": "Hover (pointer devices)",
      "when": "pointer",
      "note": "Skip on mobile-only products.",
      "css": "@media (hover:hover){.btn--solid:hover{background:#262626}.btn--outline:hover{background:#f5f5f5}.btn--destructive:hover{background:#991b1b}}"
    },
    {
      "id": "focus",
      "label": "Focus (keyboard)",
      "when": "all",
      "note": "Required for keyboard users (WCAG 2.4.7).",
      "css": ".btn:focus-visible{outline:2px solid #1d4ed8;outline-offset:2px}"
    },
    {
      "id": "pressed",
      "label": "Pressed",
      "when": "all",
      "note": "",
      "css": ".btn:active{transform:translateY(1px)}"
    },
    {
      "id": "disabled",
      "label": "Disabled",
      "when": "all",
      "note": "",
      "css": ".btn:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "id": "loading",
      "label": "Loading",
      "when": "all",
      "note": "",
      "css": ".btn[aria-busy=true]{opacity:.7;cursor:progress}"
    }
  ],
  "related": [
    "link",
    "toggle-switch",
    "popover"
  ],
  "code": {
    "html": "<div class=\"row\">\n  <button class=\"btn btn--solid\" type=\"button\">Save changes</button>\n  <button class=\"btn btn--outline\" type=\"button\">Preview</button>\n  <button class=\"btn btn--text\" type=\"button\">Cancel</button>\n  <button class=\"btn btn--destructive\" type=\"button\">Delete project</button>\n</div>",
    "css": ".row{display:flex;flex-wrap:wrap;gap:8px}\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 20px;border:1px solid #0a0a0a;border-radius:999px;font:600 14px/1 system-ui,sans-serif;cursor:pointer}\n.btn--solid{background:#0a0a0a;color:#fff}\n.btn--outline{background:#fff;color:#0a0a0a}\n.btn--text{border-color:transparent;background:none;text-decoration:underline;color:#0a0a0a}\n.btn--destructive{background:#b91c1c;border-color:#b91c1c;color:#fff}"
  },
  "os": {
    "ios": {
      "css": ".btn{border-radius:14px;min-height:50px;font:600 17px/1 -apple-system,'SF Pro Text',system-ui,sans-serif}.btn--text{text-decoration:none}"
    },
    "android": {
      "css": ".btn{border-radius:999px;min-height:40px;padding:0 24px;font:500 14px/1 Roboto,system-ui,sans-serif;letter-spacing:.1px}.btn--outline{border-color:#8a8a8a}.btn--text{text-decoration:none;padding:0 12px}"
    }
  }
}
