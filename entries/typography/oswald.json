        400,
        600
      ]
    }
  ],
  "css": "@import url('https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&display=swap');\n:root {\n  --font-main: 'Oswald', system-ui, sans-serif;\n}"
