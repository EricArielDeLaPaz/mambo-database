  "css": "@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n:root {\n  --font-main: 'Plus Jakarta Sans', system-ui, sans-serif;\n}"
